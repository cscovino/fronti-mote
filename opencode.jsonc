{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@dietrichgebert/ponytail"],
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": false,
        "codemode": false
      },
      "espressif-docs": {
        "type": "remote",
        "url": "https://mcp.espressif.com/docs"
      }
    }
  }
}
