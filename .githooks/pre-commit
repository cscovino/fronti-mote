#!/usr/bin/env bash
set -euo pipefail

# Format check for staged C/C++; host tests when code or build config moved.
staged=$(git diff --cached --name-only --diff-filter=ACMR -- \
  '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hpp')
if [ -n "$staged" ]; then
  fmt=$(command -v clang-format || command -v clang-format-18 || true)
  if [ -z "$fmt" ]; then
    echo "pre-commit: clang-format not found (sudo apt install clang-format-18)" >&2
    exit 1
  fi
  major=$("$fmt" --version | sed -E 's/[^0-9]*([0-9]+).*/\1/')
  if [ "$major" -lt 18 ]; then
    echo "pre-commit: clang-format $major is too old, need 18+" >&2
    exit 1
  fi
  while IFS= read -r file; do
    git show ":$file" | "$fmt" --dry-run --Werror --assume-filename="$file" -
  done <<< "$staged"
fi

# Host tests take ~10 s, so only when code or the build config moved.
if [ -n "$staged" ] || git diff --cached --name-only --diff-filter=ACMR |
  grep -qx 'platformio.ini'; then
  pio test -e native
fi
